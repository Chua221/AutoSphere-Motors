# Copy this file to ".env" and fill in your own values.
#
# IMPORTANT: Create React App only exposes env vars that start with
# REACT_APP_ to the browser bundle. Never put a Client SECRET in this file —
# secrets belong only in server/.env (see server/.env.example), read only by
# the Node backend, never shipped to the browser.

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# GitHub > Settings > Developer settings > OAuth Apps
REACT_APP_GITHUB_CLIENT_ID=your-github-client-id

# developers.facebook.com > My Apps > (your app) > Settings > Basic > App ID
REACT_APP_FACEBOOK_APP_ID=your-facebook-app-id

# Where the small OAuth backend (server/oauth-server.js) is running.
REACT_APP_OAUTH_SERVER_URL=http://localhost:8080
